<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>vaio-center (local)</vendor>
  <action id="org.local.vaio-center.wmi">
    <description>Control VAIO keyboard lighting, fans, performance profile and charge limit</description>
    <message>Authentication is required to change VAIO hardware settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vaio-wmi-helper</annotate>
  </action>
</policyconfig>
